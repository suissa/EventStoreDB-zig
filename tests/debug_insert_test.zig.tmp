//! Diagnostic test: open a fresh DB, try the same INSERT that
//! `append.zig` issues, and print the actual SQLite error code
//! and message. Run with `zig build test_debug`.

const std = @import("std");
const testing = std.testing;
const c = @import("c").c;
const esdb = @import("eventstoredb");
const schema_mod = @import("schema");
const bind = @import("bind");

test "diagnostic: insert one row into events" {
    const a = testing.allocator;
    const conn = try schema_mod.Connection.open(a, ":memory:", 5000);
    defer conn.close();

    // Create the streams row so the FK is satisfied (no FK in this
    // schema, but the same path appendToStream takes).
    const insert_stream_sql =
        \\INSERT INTO streams(stream_id, stream_type, revision, max_count, truncate_before, created_at, updated_at)
        \\VALUES (?, 0, -1, 0, 0, 0, 0)
    ;
    {
        const stmt_z = try a.dupeZ(u8, insert_stream_sql);
        defer a.free(stmt_z);
        var stmt: ?*c.sqlite3_stmt = null;
        if (c.sqlite3_prepare_v2(conn.db, stmt_z.ptr, -1, &stmt, null) != c.SQLITE_OK) {
            std.debug.print("prepare stream failed: {s}\n", .{c.sqlite3_errmsg(conn.db)});
            return error.PrepareFailed;
        }
        defer _ = c.sqlite3_finalize(stmt.?);
        const sid_z = try a.dupeZ(u8, "s1");
        defer a.free(sid_z);
        _ = c.sqlite3_bind_text(stmt, 1, sid_z.ptr, 2, c.SQLITE_TRANSIENT);
        const rc = c.sqlite3_step(stmt);
        std.debug.print("stream insert rc={d} msg={s}\n", .{ rc, c.sqlite3_errmsg(conn.db) });
    }

    // Now the events insert that the production code does.
    var event_id: [16]u8 = .{1} ++ .{0} ** 15;
    const sid_z = try a.dupeZ(u8, "s1");
    defer a.free(sid_z);
    const et_z = try a.dupeZ(u8, "TestType");
    defer a.free(et_z);
    const data_z = try a.dupeZ(u8, "{}");
    defer a.free(data_z);

    const sql =
        \\INSERT INTO events(event_id, stream_id, event_number, log_position, transaction_position, event_type, data, metadata, created_at)
        \\VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
    ;
    {
        const stmt_z = try a.dupeZ(u8, sql);
        defer a.free(stmt_z);
        var stmt: ?*c.sqlite3_stmt = null;
        if (c.sqlite3_prepare_v2(conn.db, stmt_z.ptr, -1, &stmt, null) != c.SQLITE_OK) {
            std.debug.print("prepare event failed: {s}\n", .{c.sqlite3_errmsg(conn.db)});
            return error.PrepareFailed;
        }
        defer _ = c.sqlite3_finalize(stmt.?);
        _ = c.sqlite3_bind_blob(stmt, 1, &event_id, 16, c.SQLITE_TRANSIENT);
        _ = c.sqlite3_bind_text(stmt, 2, sid_z.ptr, 2, c.SQLITE_TRANSIENT);
        _ = c.sqlite3_bind_int64(stmt, 3, 0);
        _ = c.sqlite3_bind_int64(stmt, 4, 1);
        _ = c.sqlite3_bind_int64(stmt, 5, 1);
        _ = c.sqlite3_bind_text(stmt, 6, et_z.ptr, 8, c.SQLITE_TRANSIENT);
        _ = c.sqlite3_bind_blob(stmt, 7, data_z.ptr, 2, c.SQLITE_TRANSIENT);
        _ = c.sqlite3_bind_null(stmt, 8);
        _ = c.sqlite3_bind_int64(stmt, 9, 1234567890);
        const rc = c.sqlite3_step(stmt);
        std.debug.print("event insert rc={d} msg={s}\n", .{ rc, c.sqlite3_errmsg(conn.db) });
        try testing.expect(rc == c.SQLITE_DONE);
    }
}
