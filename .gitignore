# past the *.db* rules above and ended up tracked.
*.tmp
ok
ok-*
demo.db
demo.db-*
/ok
/ok-*

# One-off review artefacts left in `docs/` (saved pages +
# downloaded assets). Keep them locally if you need them,
# but do not commit.
docs/Parecer-*.html
docs/Parecer-*/

# Editor / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

